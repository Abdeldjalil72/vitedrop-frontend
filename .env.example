# ==============================================================================
# ViteDrop Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# ViteDrop Backend API (NestJS service, default local: http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Playwright E2E Test Suite Base URL (default: http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Playwright Live Backend API URL for E2E tests (default: http://localhost:4000)
PLAYWRIGHT_API_BASE_URL=http://localhost:4000
